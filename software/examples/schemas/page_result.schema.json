{
  "$defs": {
    "Box": {
      "additionalProperties": false,
      "properties": {
        "x0": {
          "maximum": 1,
          "minimum": 0,
          "title": "X0",
          "type": "number"
        },
        "y0": {
          "maximum": 1,
          "minimum": 0,
          "title": "Y0",
          "type": "number"
        },
        "x1": {
          "maximum": 1,
          "minimum": 0,
          "title": "X1",
          "type": "number"
        },
        "y1": {
          "maximum": 1,
          "minimum": 0,
          "title": "Y1",
          "type": "number"
        }
      },
      "required": [
        "x0",
        "y0",
        "x1",
        "y1"
      ],
      "title": "Box",
      "type": "object"
    },
    "Participant": {
      "additionalProperties": false,
      "properties": {
        "row_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row Ref"
        },
        "bbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/Box"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "first_name": {
          "$ref": "#/$defs/TextField"
        },
        "last_name": {
          "$ref": "#/$defs/TextField"
        },
        "personnel_number": {
          "$ref": "#/$defs/TextField"
        },
        "department": {
          "$ref": "#/$defs/TextField"
        },
        "signature_present": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Signature Present"
        },
        "signature_state": {
          "default": "uncertain",
          "enum": [
            "read",
            "empty",
            "illegible",
            "uncertain",
            "failed"
          ],
          "title": "Signature State",
          "type": "string"
        },
        "signature_bbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/Box"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "signature_method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Signature Method"
        },
        "review_notes": {
          "items": {
            "type": "string"
          },
          "title": "Review Notes",
          "type": "array"
        }
      },
      "required": [
        "first_name",
        "last_name",
        "personnel_number",
        "department"
      ],
      "title": "Participant",
      "type": "object"
    },
    "TextField": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "state": {
          "default": "uncertain",
          "enum": [
            "read",
            "empty",
            "illegible",
            "uncertain",
            "failed"
          ],
          "title": "State",
          "type": "string"
        },
        "bbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/Box"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "TextField",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "document_id": {
      "title": "Document Id",
      "type": "string"
    },
    "page_number": {
      "minimum": 1,
      "title": "Page Number",
      "type": "integer"
    },
    "page_id": {
      "title": "Page Id",
      "type": "string"
    },
    "method_id": {
      "title": "Method Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "unavailable",
        "failed",
        "partial",
        "success"
      ],
      "title": "Status",
      "type": "string"
    },
    "page_text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Page Text"
    },
    "text_fallback": {
      "default": false,
      "title": "Text Fallback",
      "type": "boolean"
    },
    "participants": {
      "items": {
        "$ref": "#/$defs/Participant"
      },
      "title": "Participants",
      "type": "array"
    },
    "parse_status": {
      "default": "not_attempted",
      "enum": [
        "valid",
        "invalid",
        "not_attempted"
      ],
      "title": "Parse Status",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "timings": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Timings",
      "type": "object"
    },
    "calls": {
      "default": 0,
      "title": "Calls",
      "type": "integer"
    },
    "review_notes": {
      "items": {
        "type": "string"
      },
      "title": "Review Notes",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "document_id",
    "page_number",
    "page_id",
    "method_id",
    "status"
  ],
  "title": "PageResult",
  "type": "object"
}