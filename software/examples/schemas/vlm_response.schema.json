{
  "$defs": {
    "VisualParticipant": {
      "additionalProperties": false,
      "description": "Compact VLM output; empty strings and unknown nulls remain distinguishable.",
      "properties": {
        "row_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row Ref"
        },
        "first_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "First Name"
        },
        "last_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Last Name"
        },
        "personnel_number": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Value only from this person's Benutzer / User ID / Personalnummer cell. Use '' if visibly blank, null if masked, unreadable or ambiguous. Never substitute Kurzzeichen, department or a course/Class ID. Keep the person even without this ID.",
          "title": "Personnel Number"
        },
        "department": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Value only from Kurzzeichen / Abteilung / Organisation in this person's row, even when Benutzer is blank. May contain letters, digits, hyphens or slashes. Use '' if visibly blank, null if unknown.",
          "title": "Department"
        },
        "signature_present": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Signature Present"
        }
      },
      "required": [
        "first_name",
        "last_name",
        "personnel_number",
        "department"
      ],
      "title": "VisualParticipant",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "participants": {
      "items": {
        "$ref": "#/$defs/VisualParticipant"
      },
      "title": "Participants",
      "type": "array"
    },
    "page_text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Fallback only: transcribe all legible text if participants is empty; otherwise null.",
      "title": "Page Text"
    }
  },
  "required": [
    "participants",
    "page_text"
  ],
  "title": "VisualPageResponse",
  "type": "object"
}