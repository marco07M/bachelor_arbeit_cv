{
  "$defs": {
    "OCRTextRow": {
      "additionalProperties": false,
      "properties": {
        "person_role": {
          "default": "unknown",
          "description": "instructor only for a person explicitly labelled Kursleiter, Trainer, Dozent or equivalent. Never infer the role from a name, department, signature or row position.",
          "enum": [
            "participant",
            "instructor",
            "unknown"
          ],
          "title": "Person Role",
          "type": "string"
        },
        "role_evidence": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Copy the literal role label belonging to this person, e.g. Kursleiter or Trainer. Use null when no explicit role label exists; never copy a label belonging to another person.",
          "title": "Role Evidence"
        },
        "source_row": {
          "title": "Source Row",
          "type": "string"
        },
        "is_participant": {
          "default": true,
          "title": "Is Participant",
          "type": "boolean"
        },
        "first_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "First Name"
        },
        "last_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Last Name"
        },
        "personnel_number": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Personnel Number"
        },
        "department": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Department"
        }
      },
      "required": [
        "is_participant",
        "source_row",
        "first_name",
        "last_name",
        "personnel_number",
        "department"
      ],
      "title": "OCRTextRow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "participants": {
      "items": {
        "$ref": "#/$defs/OCRTextRow"
      },
      "title": "Participants",
      "type": "array"
    }
  },
  "required": [
    "participants"
  ],
  "title": "OCRRecordResponse",
  "type": "object"
}